# Zkopíruj tento soubor jako `.env` a doplň hodnoty ze Supabase (Project Settings -> API).
# .env je v .gitignore, takže se NEukládá do Gitu.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Sdílené admin heslo pro /admin (prototyp; ostré přihlášení = Supabase Auth doplníme později).
VITE_ADMIN_PASSWORD=zvol-si-heslo
